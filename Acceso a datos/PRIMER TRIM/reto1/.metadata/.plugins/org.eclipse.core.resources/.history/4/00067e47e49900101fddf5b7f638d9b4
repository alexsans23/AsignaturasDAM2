package reto1;

import java.io.*;
import java.util.Arrays;
import java.util.Scanner;



public class RandomAcessEnteros {
    private static final String NOMBRE_FICHERO = "datos.bin";
    private static final int TAM = 20; 
    private static final int BYTES_INT = 4;

    public static void main(String[] args) {
        int[] numeros = new int[TAM];

        File f = new File(NOMBRE_FICHERO);
        if (f.exists()) {
            try (DataInputStream dis = new DataInputStream(new FileInputStream(f))) {
                for (int i = 0; i < TAM; i++) {
                    if (dis.available() >= BYTES_INT) {
                        numeros[i] = dis.readInt();
                    } else {
                        numeros[i] = 0; 
                    }
                }
                System.out.println("Leído desde binario existente.");
            } catch (IOException e) {
                System.out.println("Error leyendo inicial: " + e.getMessage());
                Arrays.fill(numeros, 0);
            }
        } else {
            Arrays.fill(numeros, 0);
            try (DataOutputStream dos = new DataOutputStream(new FileOutputStream(f))) {
                for (int i = 0; i < TAM; i++) {
                    dos.writeInt(numeros[i]);
                }
                System.out.println("Archivo creado con 20 ceros.");
            } catch (IOException e) {
                System.out.println("Error creando archivo: " + e.getMessage());
                return;
            }
        }

        try (RandomAccessFile raf = new RandomAccessFile(f, "rwd");
             Scanner sc = new Scanner(System.in)) {

            while (true) {
                mostrar(numeros);
                System.out.print("Posición a modificar [0-" + (TAM - 1) + "] (negativo para salir): ");
                int pos;
                try {
                    pos = Integer.parseInt(sc.nextLine().trim());
                } catch (NumberFormatException e) {
                    System.out.println("Número no válido.");
                    continue;
                }
                if (pos < 0) {
                    System.out.println("Fin.");
                    break;
                }
                if (pos >= TAM) {
                    System.out.println("Fuera de rango.");
                    continue;
                }

                System.out.print("Nuevo valor para pos " + pos + ": ");
                int valor;
                try {
                    valor = Integer.parseInt(sc.nextLine().trim());
                } catch (NumberFormatException e) {
                    System.out.println("Número no válido.");
                    continue;
                }

                
                numeros[pos] = valor;

                try {
                    long offset = (long) pos * BYTES_INT;
                    raf.seek(offset);
                    raf.writeInt(valor);
                    System.out.println("Actualizado en disco (offset " + offset + ").");
                } catch (IOException e) {
                    System.out.println("Error escribiendo en disco: " + e.getMessage());
                }
            }
        } catch (IOException e) {
            System.out.println("Error con RandomAccessFile: " + e.getMessage());
        }
    }

    private static void mostrar(int[] arr) {
        System.out.print("Array: [");
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i]);
            if (i < arr.length - 1) System.out.print(", ");
        }
        System.out.println("]");
    }
}
