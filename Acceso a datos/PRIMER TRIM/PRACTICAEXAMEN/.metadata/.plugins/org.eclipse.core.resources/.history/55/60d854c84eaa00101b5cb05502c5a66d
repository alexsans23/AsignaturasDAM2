package pruebasJson;

import com.thoughtworks.xstream.XStream;
import com.thoughtworks.xstream.io.json.JettisonMappedXmlDriver;
import com.thoughtworks.xstream.security.AnyTypePermission;

import java.io.FileInputStream;
import java.io.InputStreamReader;
import java.io.Reader;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;

public class RecuperaJSON_Jettison {
    public static void main(String[] args) {
        XStream xstream = new XStream(new JettisonMappedXmlDriver());
        xstream.addPermission(AnyTypePermission.ANY);

        // Alias iguales a los usados al generar el JSON
        xstream.alias("libro", Libro.class);
        xstream.alias("biblioteca", ArrayList.class);

        try (Reader reader = new InputStreamReader(new FileInputStream("libros.json"), StandardCharsets.UTF_8)) {
            @SuppressWarnings("unchecked")
            ArrayList<Libro> biblioteca = (ArrayList<Libro>) xstream.fromXML(reader);

            System.out.println("📚 Biblioteca leída con JettisonMappedXmlDriver:");
            for (Libro l : biblioteca) {
                System.out.println(l);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
