<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Pantalla de operación actual -->
    <TextView
        android:id="@+id/tv_operation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#EEEEEE"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pantalla de resultado -->
    <TextView
        android:id="@+id/tv_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="28sp"
        android:padding="12dp"
        android:gravity="end"
        android:background="#F5F5F5"
        app:layout_constraintTop_toBottomOf="@id/tv_operation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Rejilla de botones -->
    <GridLayout
        android:id="@+id/grid_buttons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tv_result"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <!-- Fila 1 -->
        <Button
            android:id="@+id/btn_7"
            android:onClick="operandClick"
            android:text="7"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_8"
            android:onClick="operandClick"
            android:text="8"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_9"
            android:onClick="operandClick"
            android:text="9"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_div"
            android:onClick="operatorClick"
            android:text="/"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <!-- Fila 2 -->
        <Button
            android:id="@+id/btn_4"
            android:onClick="operandClick"
            android:text="4"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_5"
            android:onClick="operandClick"
            android:text="5"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_6"
            android:onClick="operandClick"
            android:text="6"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_mul"
            android:onClick="operatorClick"
            android:text="*"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <!-- Fila 3 -->
        <Button
            android:id="@+id/btn_1"
            android:onClick="operandClick"
            android:text="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_2"
            android:onClick="operandClick"
            android:text="2"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_3"
            android:onClick="operandClick"
            android:text="3"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_sub"
            android:onClick="operatorClick"
            android:text="-"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <!-- Fila 4 -->
        <Button
            android:id="@+id/btn_0"
            android:onClick="operandClick"
            android:text="0"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_dot"
            android:onClick="operandClick"
            android:text="."
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_eq"
            android:onClick="equalsClick"
            android:text="="
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btn_add"
            android:onClick="operatorClick"
            android:text="+"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <!-- Fila 5 (opcional: Clear) -->
        <Button
            android:id="@+id/btn_clear"
            android:onClick="clearClick"
            android:text="C"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnSpan="4"
            android:layout_gravity="fill_horizontal" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
